FROM nginx:alpine

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy config template
COPY config.js.template /etc/nginx/config.js.template

# Create startup script to substitute env vars
RUN echo '#!/bin/sh\n\
envsubst < /etc/nginx/config.js.template > /usr/share/nginx/html/config.js\n\
nginx -g "daemon off;"' > /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

# Expose port 80
EXPOSE 80

CMD ["/docker-entrypoint.sh"]

